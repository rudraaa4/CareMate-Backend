# Copy this file to backend/.env and fill in real values.
# Never commit the real .env file — it is listed in .gitignore.

# --- App ---
ENVIRONMENT=development

# --- Database (introduced in Phase 2) ---
# postgresql+psycopg://<user>:<password>@localhost:5432/caremate
DATABASE_URL=postgresql+psycopg://caremate_user:caremate_password@localhost:5432/caremate

# --- Auth / JWT (introduced in Phase 3) ---
# Generate a real secret with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-real-env
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- File storage (introduced in Phase 12, S3 backend added for AWS) ---
# "local" stores uploads in backend/uploads; "s3" stores them in an S3 bucket.
# With "s3", credentials come from the environment's AWS identity (an IAM role on
# EC2, or `aws configure` locally) - never put access keys in this file.
STORAGE_BACKEND=local
# S3_BUCKET=your-bucket-name
# AWS_REGION=ap-south-1
